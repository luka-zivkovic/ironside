# Postgres (OLTP: orgs, projects, API keys, export configs)
DATABASE_URL=postgres://ironside:ironside@localhost:5433/ironside

# ClickHouse (OLAP: traces, observations, scores)
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_USER=ironside
CLICKHOUSE_PASSWORD=ironside
CLICKHOUSE_DB=ironside

# Redis (ingest queue + cache)
REDIS_URL=redis://localhost:6380

# Durable pending-ingest reconciliation (worker)
INGEST_RECOVERY_INTERVAL_MS=30000
INGEST_RECOVERY_BATCH_SIZE=1000

# Retention + read-only lifecycle inventory (worker)
DEFAULT_RETENTION_DAYS=90
RETENTION_INTERVAL_MS=21600000
LIFECYCLE_PLAN_SCAN_LIMIT=100000
LIFECYCLE_PLAN_PROJECT_LIMIT=1000
# Optional exact project scope for large installations.
# LIFECYCLE_PLAN_PROJECT_ID=proj_...

# Destructive raw-object retention executor. Keep false until every API and
# worker replica is upgraded and the exact prepared intents have been reviewed.
RAW_RETENTION_EXECUTION_ENABLED=false

# Object storage (raw event log, large payloads, exports)
S3_ENDPOINT=http://localhost:9010
S3_ACCESS_KEY=ironside
S3_SECRET_KEY=ironside123
S3_BUCKET=ironside-raw
S3_REGION=us-east-1

# API
PORT=8788
WEB_ORIGINS=http://localhost:5174

# Owner browser sessions are Secure by default. Uncomment only for an explicit
# plain-HTTP localhost/LAN deployment; leave unset behind TLS.
# AUTH_INSECURE_COOKIES=true
AUTH_SESSION_IDLE_TTL_SECONDS=43200
AUTH_SESSION_ABSOLUTE_TTL_SECONDS=604800
AUTH_CHALLENGE_TTL_SECONDS=900
AUTH_RATE_LIMIT_PER_15_MINUTES=10
# Trust forwarded client IP headers only when a trusted reverse proxy is the
# sole route to the API; otherwise clients can spoof the limiter identity.
AUTH_TRUST_PROXY=false

# Encrypts export destination credentials (customer S3 secret keys) at rest.
# Generate a real secret for anything beyond local dev, e.g.: openssl rand -hex 32
IRONSIDE_ENCRYPTION_SECRET=local-dev-only-change-me
