{
  "name": "ironside-monorepo",
  "version": "0.2.0",
  "private": true,
  "description": "The system of record for AI interaction data: ingest, store, and export LLM traces.",
  "license": "SEE LICENSE IN LICENSE.md",
  "repository": {
    "type": "git",
    "url": "https://github.com/luka-zivkovic/ironside.git"
  },
  "homepage": "https://byluka.build/projects/ironside/",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "pnpm -r --sort build",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "clean": "rm -rf apps/*/dist packages/*/dist packages/*/*.tsbuildinfo apps/*/*.tsbuildinfo coverage out"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  },
  "pnpm": {
    "overrides": {
      "nanoid@3": "3.3.18",
      "postcss": "8.5.23"
    }
  }
}
